{
  "manifest_version": 3,
  "name": "Pan Triad HUD Overlay",
  "version": "0.9.10",
  "description": "Triad HUD · oneMove · DARK_HEX · alarms · triadInput",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://morrow-wrqekvms.manus.space/*",
    "https://*.manus.space/*",
    "https://api.alexalex.info/*",
    "https://pan-copilot-ixpansion-agents.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "https://morrow-wrqekvms.manus.space/*",
        "https://*.manus.space/*",
        "https://api.alexalex.info/*",
        "https://pan-copilot-ixpansion-agents.vercel.app/*"
      ],
      "js": ["content.js"],
      "css": ["pan-face.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Pan Triad HUD"
  }
}
