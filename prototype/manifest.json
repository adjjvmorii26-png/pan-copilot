{
  "manifest_version": 3,
  "name": "Pan – Panoptic Co-Pilot",
  "version": "0.9.2",
  "description": "Distributed AI co-pilot. Nebula face · Avatar · Synapse · Oracle · Shadow.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost/*", "https://*.vercel.app/*", "https://*.netlify.app/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": { "default_title": "Pan" },
  "icons": {
    "48": "icons/pan-badge.svg",
    "128": "icons/pan-badge.svg"
  }
}
