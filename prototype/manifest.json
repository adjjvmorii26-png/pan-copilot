{
  "manifest_version": 3,
  "name": "Pan – Panoptic Co-Pilot",
  "version": "0.6.0",
  "description": "Real-time distributed AI helper. Now with architecture for live organ access.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost/*", "https://*.vercel.app/*", "https://*.netlify.app/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_title": "Pan"
  }
}
